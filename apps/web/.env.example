# ReCircuit Environment Variables Template (apps/web)
# Safe placeholders only - NEVER commit real keys or production secrets

# Public Supabase Client (safe for browser exposure)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only Secrets (NEVER expose to client with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Server-side AI Provider (Gemini / OpenAI)
AI_API_KEY=your-gemini-or-openai-api-key
AI_PROVIDER=gemini # or openai, local_fallback

# App Settings
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=true
